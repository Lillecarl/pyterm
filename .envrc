#! /usr/bin/env bash

# Read the working copies as directories, not at the revision the lock names.
#
# Without this a build takes the committed tree of each source, so an edit
# you have not committed does not reach it. Measured: a `git+file://` fetch
# pinned to a revision gives the same store path with a tracked file modified
# as without. The loop here is to edit and build, so every checkout wants it.
#
# `nix/resolve.nix` says what the two arms are. CI leaves it unset, and gets
# the reproducible one.
export UMBRELLA_DEV=all

use_nix
watch_file **/*.nix
source_env_if_exists .privrc
