    "wrapty@skills-dir": true
  },
  "enabledMcpjsonServers": ["pymux"],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|mcp__plugin_pyedit_pyedit__run",
