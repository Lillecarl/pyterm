from __future__ import annotations

from collections.abc import Awaitable

Event = tuple[object, ...]
KittyUpdate = tuple[int, str | None, bool]
FrameRects = tuple[int, bool, int, int, list[tuple[int, int, int, int, bytes]]] | None
VideoFrame = tuple[int, bool, int, int, bytes, list[tuple[int, int, int, int]]] | None

class Vp9Encoder:
    def __init__(self) -> None: ...

class RemoteEncoder: ...

class Compositor:
    def __init__(self, socket_name: str | None = None, width: int = 800, height: int = 600) -> None: ...
    @property
    def socket_name(self) -> str: ...
    @property
    def output_size(self) -> tuple[int, int] | None: ...
    def fds(self) -> tuple[int, int]: ...
    def connect(self) -> tuple[int, int]: ...
    def dispatch(self) -> list[Event]: ...
    def frame(self, id: int) -> tuple[int, int, bytes] | None: ...
    def kitty_update(self, id: int, image_id: int, since: int | None = None) -> Awaitable[KittyUpdate]: ...
    def frame_rects(self, id: int, since: int | None = None) -> Awaitable[FrameRects]: ...
    def vp9_frame(self, id: int, encoder: Vp9Encoder) -> Awaitable[VideoFrame]: ...
    def vp9_encoder(self) -> Vp9Encoder: ...
    def frame_done(self, id: int, time: int) -> None: ...
    def wants_frame(self, id: int) -> bool: ...
    def toplevels(self) -> list[int]: ...
    def configure(self, id: int, width: int, height: int, scale: float = 1.0) -> None: ...
    def close(self, id: int) -> None: ...
    def shutdown(self) -> None: ...
    def focus(self, id: int) -> None: ...
    def key(self, code: int, pressed: bool, time: int) -> None: ...
    def commit_text(self, text: str) -> bool: ...
    def pointer_motion(self, id: int, x: float, y: float, time: int) -> None: ...
    def pointer_leave(self, id: int, time: int) -> None: ...
    def pointer_button(self, button: int, pressed: bool, time: int) -> None: ...
    def pointer_scroll(self, steps: int, time: int, horizontal: bool = False) -> None: ...
    def pointer_scroll_smooth(self, id: int, pixels: float, time: int, horizontal: bool = False) -> None: ...
    def set_selection(self, target: str, offers: dict[str, bytes | None]) -> None: ...
    def clear_selection(self, target: str) -> None: ...
    def request_selection(self, target: str, mime_type: str) -> int: ...

class HostRequest:
    @property
    def seq(self) -> int: ...
    @property
    def name(self) -> str: ...

class Channel:
    def __init__(self, fd: int) -> None: ...
    def fileno(self) -> int: ...
    def hello(self, compositor: Compositor) -> None: ...
    def failed(self, why: str) -> None: ...
    def requests(self) -> tuple[list[HostRequest], bool]: ...
    def answer(self, compositor: Compositor, request: HostRequest) -> None: ...
    def forward(self, compositor: Compositor) -> None: ...

class RemoteCompositor:
    @staticmethod
    def start(fd: int, timeout: float = 60.0) -> Awaitable[RemoteCompositor]: ...
    @property
    def socket_name(self) -> str: ...
    @property
    def output_size(self) -> tuple[int, int] | None: ...
    @property
    def version(self) -> int: ...
    def fds(self) -> tuple[int]: ...
    def connect(self) -> tuple[int, int]: ...
    def dispatch(self) -> list[Event]: ...
    def frame(self, id: int) -> tuple[int, int, bytes] | None: ...
    def kitty_update(self, id: int, image_id: int, since: int | None = None) -> Awaitable[KittyUpdate]: ...
    def frame_rects(self, id: int, since: int | None = None) -> Awaitable[FrameRects]: ...
    def vp9_frame(self, id: int, encoder: RemoteEncoder) -> Awaitable[VideoFrame]: ...
    def vp9_encoder(self) -> RemoteEncoder: ...
    def frame_done(self, id: int, time: int) -> None: ...
    def wants_frame(self, id: int) -> bool: ...
    def toplevels(self) -> list[int]: ...
    def configure(self, id: int, width: int, height: int, scale: float = 1.0) -> None: ...
    def close(self, id: int) -> None: ...
    def shutdown(self) -> None: ...
    def focus(self, id: int) -> None: ...
    def key(self, code: int, pressed: bool, time: int) -> None: ...
    def commit_text(self, text: str) -> bool: ...
    def pointer_motion(self, id: int, x: float, y: float, time: int) -> None: ...
    def pointer_leave(self, id: int, time: int) -> None: ...
    def pointer_button(self, button: int, pressed: bool, time: int) -> None: ...
    def pointer_scroll(self, steps: int, time: int, horizontal: bool = False) -> None: ...
    def pointer_scroll_smooth(self, id: int, pixels: float, time: int, horizontal: bool = False) -> None: ...
    def set_selection(self, target: str, offers: dict[str, bytes | None]) -> None: ...
    def clear_selection(self, target: str) -> None: ...
    def request_selection(self, target: str, mime_type: str) -> int: ...
